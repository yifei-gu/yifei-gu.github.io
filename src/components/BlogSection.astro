---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section id="blog" class="py-24 px-4 relative overflow-hidden">
  <!-- Enhanced Background -->
  <div class="absolute inset-0 bg-deep-100/30 dark:bg-deep-900/30"></div>
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-linear-to-r from-transparent via-ocean-500/20 to-transparent"
  >
  </div>
  
  <!-- Decorative elements -->
  <div class="absolute top-20 left-10 w-32 h-32 bg-ocean-500/5 rounded-full blur-2xl pointer-events-none"></div>
  <div class="absolute bottom-20 right-10 w-40 h-40 bg-ocean-500/5 rounded-full blur-2xl pointer-events-none"></div>

  <div class="max-w-4xl mx-auto relative">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">
        <span class="text-ocean-500 font-mono text-lg block mb-2">// blog</span>
        <span class="text-deep-800 dark:text-white">Research Blog</span>
      </h2>
      <p class="text-deep-600 dark:text-deep-300 max-w-2xl mx-auto mt-4">
        Notes on my research, software releases, and thoughts on ecology ×
        technology.
      </p>
    </div>

    <div class="space-y-5">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="block glass rounded-xl p-6 hover:border-ocean-500/40 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-ocean-500/10 group"
          >
            <div class="flex items-center gap-3 mb-3 flex-wrap">
              <time class="text-xs font-mono text-ocean-500 px-2.5 py-0.5 rounded bg-ocean-500/10 border border-ocean-500/20">
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
              {post.data.tags.map((tag: string) => (
                <span class="text-xs px-2 py-0.5 rounded-full bg-deep-200 dark:bg-deep-700 text-deep-600 dark:text-deep-300">
                  {tag}
                </span>
              ))}
            </div>
            <h3 class="text-lg font-bold text-deep-800 dark:text-white group-hover:text-ocean-600 dark:group-hover:text-ocean-400 transition-colors mb-2">
              {post.data.title}
            </h3>
            <p class="text-sm text-deep-600 dark:text-deep-300 leading-relaxed">
              {post.data.description}
            </p>
            <span class="inline-block mt-3 text-sm text-ocean-500 font-medium group-hover:translate-x-1 transition-transform">
              Read more →
            </span>
          </a>
        ))
      }
    </div>

    {
      posts.length === 0 && (
        <div class="text-center py-16 text-deep-600 dark:text-deep-300">
          <p class="text-lg">No posts yet. Check back soon!</p>
        </div>
      )
    }

    {
      posts.length > 0 && (
        <div class="text-center mt-10">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-6 py-3 border-2 border-ocean-500/30 dark:border-ocean-500/50 text-ocean-600 dark:text-ocean-400 hover:border-ocean-500 hover:bg-ocean-500/10 font-medium rounded-lg transition-all duration-300 hover:-translate-y-1 group"
          >
            View All Posts
            <svg
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</section>
