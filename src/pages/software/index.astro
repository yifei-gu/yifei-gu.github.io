---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar";
import Footer from "../../components/Footer";
import SoftwareIndex from "../../components/SoftwareIndex";
import { getCollection } from "astro:content";

const software = (await getCollection("software")).sort((a, b) => {
  // Authored first, then contributed
  if (a.data.contributed !== b.data.contributed) {
    return a.data.contributed ? 1 : -1;
  }
  return 0;
});

// Get all unique tags
const allTags = Array.from(new Set(software.flatMap((sw) => sw.data.tags)));
---

<Layout
  title="Software | Yifei Gu"
  description="Open-source scientific software tools built for the research community."
>
  <Navbar client:load />

  <main class="pt-28 pb-16 px-4">
    <SoftwareIndex client:visible software={software} allTags={allTags} />
  </main>

  <Footer />
</Layout>
