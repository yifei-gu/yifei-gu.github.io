---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar";
import Footer from "../../components/Footer";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const software = await getCollection("software");
  return software.map((sw) => ({
    params: { slug: sw.slug },
    props: sw,
  }));
}

const software = Astro.props;
const { Content } = await software.render();

// Get related blog posts (by matching tags or software reference)
const allPosts = await getCollection("blog");
const relatedPosts = allPosts
  .filter((post) => !post.data.draft)
  .filter((post) => 
    // Match by software reference
    post.data.software === software.slug ||
    // Or by matching tags
    post.data.tags.some((tag) => software.data.tags.includes(tag))
  )
  .slice(0, 3);
---

<Layout
  title={`${software.data.name} | Yifei Gu`}
  description={software.data.description}
>
  <Navbar client:load />

  <main class="pt-28 pb-16 px-4">
    <article class="max-w-3xl mx-auto">
      <!-- Back link -->
      <a
        href="/software"
        class="inline-flex items-center gap-1 text-sm text-ocean-500 hover:text-ocean-600 mb-8 group"
      >
        <svg
          class="w-4 h-4 group-hover:-translate-x-1 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"
          ></path>
        </svg>
        Back to Software
      </a>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          {software.data.tags.map((tag) => (
            <span class="text-xs px-3 py-1 rounded-full bg-ocean-500/10 text-ocean-600 dark:text-ocean-400 border border-ocean-500/20">
              {tag}
            </span>
          ))}
          {software.data.contributed && (
            <span class="text-xs px-3 py-1 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
              Contributed
            </span>
          )}
        </div>
        
        <h1 class="text-3xl sm:text-4xl font-bold text-deep-800 dark:text-white leading-tight mb-4">
          {software.data.name}
        </h1>
        
        <p class="text-lg text-deep-600 dark:text-deep-300 mb-6">
          {software.data.description}
        </p>

        <!-- Action Links -->
        <div class="flex flex-wrap gap-3">
          <a
            href={software.data.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-ocean-500 hover:bg-ocean-400 text-white font-medium rounded-lg transition-all duration-300 hover:shadow-lg hover:shadow-ocean-500/30"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            View on GitHub
          </a>
          
          {software.data.paper && (
            <a
              href={`https://scholar.google.com/scholar?q=${encodeURIComponent(software.data.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-ocean-500/30 dark:border-ocean-500/50 text-ocean-600 dark:text-ocean-400 hover:border-ocean-500 hover:bg-ocean-500/10 font-medium rounded-lg transition-all duration-300"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Read Paper
            </a>
          )}
        </div>
      </header>

      <!-- Related Papers Section -->
      {software.data.relatedPapers && software.data.relatedPapers.length > 0 && (
        <div class="mb-10">
          <h2 class="text-xl font-bold text-deep-800 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Related Publications
          </h2>
          <div class="space-y-3">
            {software.data.relatedPapers.map((paper) => (
              <div class="glass rounded-lg p-4">
                <a
                  href={paper.url || `https://scholar.google.com/scholar?q=${encodeURIComponent(paper.title)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-medium text-deep-800 dark:text-white hover:text-ocean-500 dark:hover:text-ocean-400 transition-colors"
                >
                  {paper.title}
                </a>
                <p class="text-sm text-deep-600 dark:text-deep-300 mt-1">
                  {paper.authors}
                </p>
                <p class="text-sm text-deep-500 dark:text-deep-400">
                  <em>{paper.journal}</em> ({paper.year})
                </p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Related Blog Posts -->
      {relatedPosts.length > 0 && (
        <div class="mb-10">
          <h2 class="text-xl font-bold text-deep-800 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
            Related Blog Posts
          </h2>
          <div class="space-y-3">
            {relatedPosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="block glass rounded-lg p-4 hover:border-ocean-500/40 transition-all group"
              >
                <div class="flex items-center gap-2 mb-2">
                  <time class="text-xs font-mono text-ocean-500">
                    {post.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-deep-200 dark:bg-deep-700 text-deep-600 dark:text-deep-300">
                      {tag}
                    </span>
                  ))}
                </div>
                <h3 class="font-medium text-deep-800 dark:text-white group-hover:text-ocean-500 transition-colors">
                  {post.data.title}
                </h3>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Main Content -->
      <div class="prose prose-lg dark:prose-invert prose-headings:text-deep-800 dark:prose-headings:text-white prose-a:text-ocean-500 prose-code:text-ocean-500 prose-pre:bg-deep-900 prose-pre:border prose-pre:border-deep-700 max-w-none">
        <Content />
      </div>
    </article>
  </main>

  <Footer client:load />
</Layout>
