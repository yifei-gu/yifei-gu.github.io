---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar";
import Footer from "../../components/Footer";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Blog | Yifei Gu"
  description="Research blog posts about AI, ecology, scientific software, and marine science."
>
  <Navbar client:load />

  <main class="pt-28 pb-24 px-4">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-bold mb-4">
        <span class="text-ocean-500 font-mono text-lg block mb-2">// blog</span>
        Research Blog
      </h1>
      <p class="text-deep-600 dark:text-deep-300 mb-12">
        Notes on my research, software releases, and thoughts on ecology ×
        technology.
      </p>

      <div class="space-y-6">
        {
          posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="block glass rounded-xl p-6 hover:border-ocean-500/40 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-ocean-500/10 group"
            >
              <div class="flex items-center gap-3 mb-3">
                <time class="text-xs font-mono text-ocean-500 px-2 py-0.5 rounded bg-ocean-500/10">
                  {post.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
                {post.data.tags.map((tag: string) => (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-deep-200 dark:bg-deep-700 text-deep-600 dark:text-deep-300">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="text-xl font-bold text-deep-800 dark:text-white group-hover:text-ocean-500 transition-colors mb-2">
                {post.data.title}
              </h2>
              <p class="text-sm text-deep-600 dark:text-deep-300 leading-relaxed">
                {post.data.description}
              </p>
              <span class="inline-block mt-3 text-sm text-ocean-500 font-medium group-hover:translate-x-1 transition-transform">
                Read more →
              </span>
            </a>
          ))
        }
      </div>

      {
        posts.length === 0 && (
          <div class="text-center py-20 text-deep-400 dark:text-deep-500">
            <p class="text-lg">No posts yet. Check back soon!</p>
          </div>
        )
      }
    </div>
  </main>

  <Footer client:load />
</Layout>
